# Dockerfile.api
FROM python:3.12-slim AS base

COPY --from=ghcr.io/astral-sh/uv:0.9.9 /uv /uvx /usr/local/bin/

WORKDIR /app

COPY docker/requirements-api.txt .
RUN uv pip install --system -r requirements-api.txt

COPY src/api ./src/api
COPY src/agents ./src/agents
COPY src/config ./src/config
COPY src/errors ./src/errors
COPY src/mcp_servers/__init__.py src/mcp_servers/client.py ./src/mcp_servers/
COPY src/main.py ./src/main.py

ENV PYTHONPATH=/app/src PYTHONUNBUFFERED=1
EXPOSE 8443
CMD ["python", "src/main.py"]