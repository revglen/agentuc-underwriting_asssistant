# Dockerfile.mcp
FROM python:3.12-slim AS base

COPY --from=ghcr.io/astral-sh/uv:0.9.9 /uv /uvx /usr/local/bin/

WORKDIR /app

COPY docker/requirements-mcp.txt .
RUN uv pip install --system -r requirements-mcp.txt

COPY src/mcp_servers ./mcp_servers
#COPY src/agents/__init__.py src/agents/llm.py src/agents/llm_gateway.py ./agents
COPY src/agents ./agents
COPY src/config ./config
COPY src/errors ./errors
COPY src/observability ./observability
COPY src/guardrails ./guardrails
COPY docker/mcp-entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh

ENV PYTHONPATH=/app PYTHONUNBUFFERED=1
EXPOSE 8001 8002 8003 9001 9002 9003
ENTRYPOINT ["./entrypoint.sh"]